# ---------------- ROUTE INTELLIGENCE ----------------

@app.post("/api/route")
def calculate_route(data: RouteRequest):

    url = (
        "https://router.project-osrm.org/route/v1/driving/"
        f"{data.origin_lon},{data.origin_lat};"
        f"{data.destination_lon},{data.destination_lat}"
    )

    params = {
        "overview": "full",
        "geometries": "geojson",
        "alternatives": "true",
        "steps": "true"
    }

    try:

        response = requests.get(
            url,
            params=params,
            timeout=20
        )

        response.raise_for_status()
        result = response.json()

        if result.get("code") != "Ok":
            raise ValueError("No route found")

        routes = []

        for index, route in enumerate(result["routes"]):

            distance = route["distance"] / 1000
            duration = route["duration"] / 60

            # Transparent route ranking score.
            score = duration + (distance * 0.15)

            routes.append({
                "route_number": index + 1,
                "distance_km": round(distance, 2),
                "eta_minutes": round(duration, 1),
                "score": round(score, 2),
                "geometry": route["geometry"]
            })

        routes.sort(key=lambda x: x["score"])

        best = routes[0]

    except requests.RequestException:
        raise HTTPException(
            status_code=503,
            detail="Routing service unavailable. Please try again."
        )

    except (ValueError, KeyError, IndexError):
        raise HTTPException(
            status_code=422,
            detail="Unable to calculate a route for these coordinates."
        )

    if data.ambulance_id:

        with get_db() as con:

            ambulance = con.execute(
                "SELECT ambulance_id FROM ambulances WHERE ambulance_id=?",
                (data.ambulance_id,)
            ).fetchone()

            if ambulance:
                con.execute("""
                UPDATE ambulances
                SET status='ON_TRIP'
                WHERE ambulance_id=?
                """, (data.ambulance_id,))

    with get_db() as con:

        con.execute("""
        INSERT INTO trips
        (ambulance_id, origin_lat, origin_lon,
         destination_lat, destination_lon,
         distance, eta, status, created_at)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            data.ambulance_id,
            data.origin_lat,
            data.origin_lon,
            data.destination_lat,
            data.destination_lon,
            best["distance_km"],
            best["eta_minutes"],
            "PLANNED",
            datetime.now().isoformat()
        ))

    return {
        "recommended_route": best,
        "alternative_routes": routes[1:],
        "note": (
            "ETA is a road-routing estimate. "
            "Live traffic data is not connected."
        )
    }


